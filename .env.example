# Copy to .env.local. Never paste real keys into chat or commit them.
# demo = offline/free; openai = real AI (requires enabled flag, key and budgets).
EDUFLOW_GENERATOR=demo
EDUFLOW_AI_ENABLED=false
EDUFLOW_AI_API_KEY=
EDUFLOW_AI_MODEL=gpt-5.4-mini-2026-03-17
# Official standard prices, checked 2026-10-08. Verify before increasing caps/model.
EDUFLOW_AI_INPUT_USD_PER_MILLION=0.75
EDUFLOW_AI_OUTPUT_USD_PER_MILLION=4.50
EDUFLOW_AI_REQUEST_BUDGET_USD=0.10
EDUFLOW_AI_DAY_BUDGET_USD=0.5
EDUFLOW_AI_MONTH_BUDGET_USD=2
EDUFLOW_AI_MAX_INPUT_TOKENS=16000
EDUFLOW_AI_MAX_OUTPUT_TOKENS=8000
EDUFLOW_AI_REQUESTS_PER_HOUR=5
EDUFLOW_AI_MAX_CONCURRENT=1
