# Copy to .env.local. Never paste real keys into chat or commit them.
# demo = offline/free; openai = real AI (requires enabled flag, key and budgets);
# gemini = the team Gemini key below, used by everyone on this PC without entering a key.
EDUFLOW_GENERATOR=demo
# Gemini team key (Google AI Studio). The operator sets it once; the app never shows it.
# Free-tier keys may let Google use inputs to improve its products: use shareable material.
# Models: gemini-3.8-flash (default) or gemini-3.5-flash-lite. Restart the server after changes.
EDUFLOW_GEMINI_API_KEY=
EDUFLOW_GEMINI_MODEL=gemini-3.8-flash
# Optional storyboard images: enable with consent in the in-app model connection screen.
# Uses the existing OpenAI key or Gemini team key, sharing the daily/monthly ledger.
# OpenAI: gpt-image-2-2026-04-21, 1536x864 low; Google: gemini-nano-banana-2.1, 16:9 1K.
# One image/call with no automatic retry. Text model selection is preserved.
# Optional lower per-request reservation ceiling (default 0.30 USD).
EDUFLOW_IMAGE_REQUEST_BUDGET_USD=0.30
EDUFLOW_AI_ENABLED=false
EDUFLOW_AI_API_KEY=
EDUFLOW_AI_MODEL=gpt-5.4-mini-2026-03-17
# Official standard prices, checked 2026-10-08. Verify before increasing caps/model.
EDUFLOW_AI_INPUT_USD_PER_MILLION=0.75
EDUFLOW_AI_OUTPUT_USD_PER_MILLION=4.50
EDUFLOW_AI_REQUEST_BUDGET_USD=0.10
# Shared per-PC caps: day $1 / month $5. Personal settings may only lower them.
EDUFLOW_AI_DAY_BUDGET_USD=1.00
EDUFLOW_AI_MONTH_BUDGET_USD=5.00
EDUFLOW_AI_MAX_INPUT_TOKENS=16000
EDUFLOW_AI_MAX_OUTPUT_TOKENS=8000
EDUFLOW_AI_REQUESTS_PER_HOUR=5
EDUFLOW_AI_MAX_CONCURRENT=1
# Keys can also be saved on the in-app connection screen (stored in .eduflow-private/).
# Optional lower per-request cap for Claude API keys (defaults: Opus 0.50, Sonnet 0.25, Haiku 0.02).
EDUFLOW_ANTHROPIC_REQUEST_BUDGET_USD=
# PPT/PPTX: install LibreOffice on the server PC. Optional absolute soffice path.
# If omitted, search PATH and the standard macOS/Windows installation.
EDUFLOW_OFFICE_CONVERTER_PATH=
# Optional local Korean/CJK font files for the private Office profile.
# Separate absolute paths with ':' on macOS/Linux, ';' on Windows. Never upload fonts.
# Defaults: Apple Gothic (macOS), Malgun Gothic (Windows), Noto CJK/Nanum (Linux).
EDUFLOW_OFFICE_FONT_FILES=

# HWP 5/HWPX: run npm run setup:hwp once on each server PC.
# Defaults to .eduflow-private/tools/rhwp/rhwp (rhwp.exe on Windows), then PATH.
EDUFLOW_HWP_CONVERTER_PATH=
# Optional actual font family name when using a custom Korean fallback font.
# Defaults: AppleGothic (macOS), Malgun Gothic (Windows), Noto Sans CJK KR (Linux).
EDUFLOW_HWP_FALLBACK_FONT=
